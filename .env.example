# # ---------- Core (required) ----------
# APP_ENV=production
# PORT=8080
# MONGODB_URI=<new Atlas connection string>
# MONGODB_DB=shopbd
# JWT_SECRET=<openssl rand -base64 48>
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=720h
# AUTO_CREATE_INDEXES=true

# # ---------- URLs, cookies, CORS (required) ----------
# FRONTEND_URL=https://yourdomain.com
# PUBLIC_API_URL=https://api.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# COOKIE_SECURE=true
# COOKIE_DOMAIN=
# TRUST_PROXY=true

# # ---------- Admin (set both) ----------
# ADMIN_EMAIL=<your admin email>
# ADMIN_PASSWORD=<long random password>

# # ---------- Email (required for admin login codes) ----------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=<email>
# SMTP_PASSWORD=<new app password>
# SMTP_FROM=<email>

# # ---------- Courier (required in production) ----------
# COURIER_ENCRYPTION_KEY=<new 32-byte base64 key>
# COURIER_FINGERPRINT_KEY=<new 32-byte base64 key>
# # PATHAO_BASE_URL=<only if you override Pathao's default>

# # ---------- Image uploads: Cloudflare R2 ----------
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=<new>
# R2_SECRET_ACCESS_KEY=<new>
# R2_PUBLIC_URL=https://<your custom bucket domain>

# # ---------- Payments: SSLCommerz ----------
# SSLCOMMERZ_STORE_ID=<real store id>
# SSLCOMMERZ_STORE_PASSWORD=<real password>
# SSLCOMMERZ_SANDBOX=false

# # ---------- Custom domains ----------
# CUSTOM_DOMAIN_ASK_TOKEN=<new long random value>
# CUSTOM_DOMAIN_IPS=<VPS public IP>
# CUSTOM_DOMAIN_CNAME_TARGET=stores.yourdomain.com
# PLATFORM_DOMAINS=yourdomain.com
# # CUSTOM_DOMAIN_DNS_SERVER=1.1.1.1:53

# # ---------- Plans ----------
# ENFORCE_PLAN_LIMITS=true

# # ---------- Google login (optional) ----------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=<new>

# # ---------- Optional extras ----------
# # REDIS_URL=rediss://...        (use it if you run more than one backend instance)
# # CLAMAV_ADDR=host:3310         (virus scan for uploads)
# # APPLE_CLIENT_ID= APPLE_TEAM_ID= APPLE_KEY_ID= APPLE_PRIVATE_KEY=   (Apple login)
# # SOCIAL_REDIRECT_BASE=         (defaults to PUBLIC_API_URL)
# # ORDER_NUMBER_PREFIX=
# # ORDER_PAYMENT_WINDOW=
# # TRY_THE_LOOK_PRICE_BDT=
# # UPLOAD_ORPHAN_DELETE=

# # ---------- Local testing only, never in production ----------
# # CUSTOM_DOMAIN_DEV=true